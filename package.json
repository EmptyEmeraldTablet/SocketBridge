{
  "name": "isaac-socketbridge",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "description": "Typed REPENTOGON runtime observation and control for Isaac mod tests",
  "engines": { "node": ">=22" },
  "bin": { "socketbridge": "dist/host/cli.js" },
  "scripts": {
    "build": "node tools/build.mjs",
    "check": "npm run build && npm test",
    "test": "node --test tests/*.test.mjs",
    "serve": "node dist/host/cli.js serve",
    "scenario": "node dist/host/cli.js run",
    "deploy": "node tools/deploy.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "fengari": "^0.1.5",
    "isaac-typescript-definitions": "43.0.6",
    "isaacscript-common": "87.9.6",
    "typescript": "5.9.3",
    "typescript-to-lua": "1.34.0"
  }
}
